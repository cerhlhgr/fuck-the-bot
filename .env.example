TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TIMEWEB_AI_API_KEY=your_timeweb_ai_key
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
LISTEN_ADDR=:8080
# Leave all three SUNO_* variables unset to disable track generation.
SUNO_API_URL=https://apibox.erweima.ai/api/v1
SUNO_API_SECRET_KEY=your_kie_api_key
SUNO_API_CALLBACK_URL=https://bot.helpslacker.ru
DECISION_INTERVAL=30s
# Optional: enables web, image, video and news search.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
